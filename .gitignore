# Source screen recordings stay local; compressed MP4/GIF derivatives are tracked
img/capability/*.mov
img/capability/逆向工具mvp.mp4

# marimo notebook state and cell cache (rebuilt on the next run)
__marimo__/

# Per-example generated artifacts (each example exports to its own out/)
examples/*/out/
examples/bowl_connector/re_work/
examples/bowl_connector/__pycache__/
examples/bowl_connector/.re_server.lock
session-audit-*.md

# Editor web UI (built into the package: `cd editor-web && npm run build`)
editor-web/node_modules/
editor-web/dist/
src/simplecadapi/editor/webui/

# The editor's per-workspace state (kernel log, snapshot, viewport image)
.sca-editor/
# Written by `sca edit` into a workspace to put marimo in lazy mode
.marimo.toml

# Local tooling and private work, never part of the repo
sandbox-envs/
.omp/
.claude/
.agents/
.sharednet/
design-docs/

# local, not part of the SDK
examples/workspace/
phase2-contract-review.md

# the C++ extension built in place (see src/cpp/bindings/python/CMakeLists.txt)
src/simplecadapi/_cpp/*.so
src/simplecadapi/_cpp/*.pyd
src/simplecadapi/_cpp/*.dylib
