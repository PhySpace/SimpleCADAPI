# UBSan suppressions for the sanitizer CI job (UBSAN_OPTIONS=suppressions=...).
#
# OCCT's own mesher (BRepMesh_NodeInsertionMeshAlgo::initDataStructure -> TopoDS::Face) reads a TopoDS_Shape at an
# address that is only 4-byte aligned.  Every frame of the report is inside OCCT; the first frame of ours is the call
# to BRepMesh_IncrementalMesh (src/io/mesh.cpp).  Only the alignment check, only for OCCT's TopoDS headers: the same
# check stays on for this repository's own code.
alignment:*/opencascade/TopoDS.hxx
