{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplecad.dev/schemas/part-definition-2.schema.json",
  "title": "SimpleCAD PartDefinition 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "definition_kind", "definition_id", "revision", "content_hash", "units", "tolerance_profile", "profile", "generator", "definition", "solid_cache", "topology_snapshot_ref", "connectors", "material_ref", "file_inputs", "interface_hashes", "metadata"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_kind": {"const": "part_definition"},
    "definition_kind": {"const": "single_solid"},
    "definition_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/revision"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "units": {"const": "mm"},
    "tolerance_profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile": {"const": "simplecad-part-definition-2"},
    "generator": {"$ref": "#/$defs/generator"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "feature_graph_ref"],
      "properties": {
        "kind": {"const": "feature_graph"},
        "feature_graph_ref": {"$ref": "#/$defs/blobRef"}
      }
    },
    "solid_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_profile", "body_ref"],
      "properties": {
        "evaluator_profile": {"const": "ocp-evaluated-solid-1"},
        "body_ref": {"$ref": "#/$defs/blobRef"}
      }
    },
    "topology_snapshot_ref": {"$ref": "#/$defs/blobRef"},
    "connectors": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/connector"}},
    "material_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/materialRef"}]},
    "file_inputs": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/fileInput"}},
    "interface_hashes": {"$ref": "#/$defs/interfaceHashes"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "x_axis", "y_axis", "z_axis"],
      "properties": {"origin": {"$ref": "#/$defs/vec3"}, "x_axis": {"$ref": "#/$defs/vec3"}, "y_axis": {"$ref": "#/$defs/vec3"}, "z_axis": {"$ref": "#/$defs/vec3"}}
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simplecadapi_version", "ocp_version", "python_abi", "platform_tag", "semantic_registry_version"],
      "properties": {
        "simplecadapi_version": {"$ref": "#/$defs/revision"},
        "ocp_version": {"$ref": "#/$defs/revision"},
        "python_abi": {"$ref": "#/$defs/revision"},
        "platform_tag": {"$ref": "#/$defs/revision"},
        "semantic_registry_version": {"$ref": "#/$defs/revision"}
      }
    },
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "fileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "materialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "path", "revision", "sha256", "byte_length"],
      "properties": {"material_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "revision": {"$ref": "#/$defs/revision"}, "sha256": {"$ref": "#/$defs/hash"}, "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "name", "anchor_kind", "local_frame", "binding", "interface_hash", "binding_hash"],
      "properties": {
        "connector_id": {"$ref": "#/$defs/id"},
        "name": {"type": ["string", "null"], "minLength": 1},
        "anchor_kind": {"enum": ["geometry", "placement"]},
        "local_frame": {"$ref": "#/$defs/frame"},
        "binding": {"type": ["object", "null"]},
        "interface_hash": {"$ref": "#/$defs/hash"},
        "binding_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "hashMap": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "interfaceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "connectors", "bindings", "material"],
      "properties": {"geometry": {"$ref": "#/$defs/hash"}, "connectors": {"$ref": "#/$defs/hashMap"}, "bindings": {"$ref": "#/$defs/hashMap"}, "material": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}}
    }
  }
}
