+    if category in {"hole", "extrusion"}:
+        result.update(_profile_dimensions(profile))
+    if category == "hole":
+        diameters = geometry.get("diameters") or profile.get("diameters") or []
+        result.update(
+            {
+                "depth": _dimension(
+                    geometry.get("total_depth"), "mm", "孔深无法从终端面确定"
+                ),
+                "entry_diameter": _dimension(
