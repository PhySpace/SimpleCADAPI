+    """Sweep ordered Wire/endpoint-Vertex sections along one path with history."""
+
+    graph_id = _make_id("g")
+    node_id = _make_id("n")
+    sweep_op = _make_multi_section_pipe_shell_builder(
+        [section.wrapped for section in sections],
+        path.wrapped,
+        frame_policy=frame_policy,
+        with_contact=with_contact,
