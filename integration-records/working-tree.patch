+            sweep_op,
+            section.wrapped,
+            graph_id,
+            node_id,
+            f"section_{index}",
+            TopoKind.EDGE,
+            TopAbs_EDGE,
+            result_shape=result_solid.wrapped,
+            generated_result_role="multi_section_sweep.side",
+            project_source_tags=True,
+        )
+        preserved.extend(pres)
+        modified.extend(mod)
+        generated.extend(gen)
+        deleted.extend(del_)
+        history_entries.extend(entries)
+
+    roles = _roles_from_history(history_entries, evidence_method="Generated")
+    for section, candidate, role, method in (
+        (sections[0], sweep_op.FirstShape(), "multi_section_sweep.start", "FirstShape"),
+        (sections[-1], sweep_op.LastShape(), "multi_section_sweep.end", "LastShape"),
+    ):
