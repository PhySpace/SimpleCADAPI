+def _validated_multi_section_sweep_inputs(
+    sections: Sequence[Union[Wire, Vertex]],
+    path: Wire,
+    *,
+    frame_policy: str,
+    auxiliary_spine: Optional[Wire],
+    auxiliary_contact: str,
+    operation: str,
+) -> Tuple[List[Union[Wire, Vertex]], str, str]:
+    section_list = _validated_loft_sections(sections, operation=operation)
+    if not isinstance(path, Wire):
+        raise TypeError(f"{operation} path must be a Wire")
+    normalized_policy = str(frame_policy).strip().lower()
+    if normalized_policy not in {"corrected_frenet", "frenet", "auxiliary_spine"}:
+        raise ValueError(
+            "frame_policy must be 'corrected_frenet', 'frenet', or 'auxiliary_spine'"
+        )
+    if auxiliary_spine is not None and not isinstance(auxiliary_spine, Wire):
+        raise TypeError("auxiliary_spine must be a Wire or None")
+    if normalized_policy == "auxiliary_spine" and auxiliary_spine is None:
+        raise ValueError("auxiliary_spine frame policy requires auxiliary_spine")
+    if normalized_policy != "auxiliary_spine" and auxiliary_spine is not None:
+        raise ValueError(
+            "auxiliary_spine may only be supplied with frame_policy='auxiliary_spine'"
+        )
+    normalized_contact = str(auxiliary_contact).strip().lower()
+    if normalized_contact not in {"none", "contact", "contact_on_border"}:
+        raise ValueError(
+            "auxiliary_contact must be 'none', 'contact', or 'contact_on_border'"
+        )
+    return section_list, normalized_policy, normalized_contact
+
