+def preflight_loft(
+    sections: Sequence[Union[Wire, Vertex]],
+    *,
+    result_kind: str = "solid",
+    ruled: bool = False,
+    boundary_conditions: Optional[Mapping[str, object]] = None,
+) -> Dict[str, object]:
+    """Validate loft inputs without constructing the loft.
+
+    The report is JSON-safe. It checks topology, endpoint singularities,
+    section order, approximate orientation continuity, and predicted ruled
+    side complexity. Endpoint tangent/draft/magnitude conditions are reported
+    as unsupported because the current ThruSections backend cannot enforce
+    them portably.
+    """
+
+    errors: List[Dict[str, object]] = []
+    warnings: List[Dict[str, object]] = []
+    try:
+        section_list = _validated_loft_sections(sections, operation="preflight_loft")
+    except (TypeError, ValueError) as exc:
+        return {
+            "schema_version": "1.0",
+            "valid": False,
+            "can_build_shell": False,
+            "can_build_solid": False,
+            "errors": [{"code": "invalid_sections", "message": str(exc)}],
+            "warnings": [],
+            "metrics": {},
+        }
+
+    kind = str(result_kind).strip().lower()
+    if kind not in {"solid", "shell"}:
+        errors.append(
+            {
+                "code": "invalid_result_kind",
+                "message": "result_kind must be 'solid' or 'shell'",
+            }
+        )
+    wire_sections = [section for section in section_list if isinstance(section, Wire)]
+    open_wire_indices = [
+        index
+        for index, section in enumerate(section_list)
+        if isinstance(section, Wire) and not section.is_closed()
+    ]
+    invalid_wire_indices = [
+        index
+        for index, section in enumerate(section_list)
+        if isinstance(section, Wire)
+        and not BRepCheck_Analyzer(section.wrapped).IsValid()
+    ]
+    if invalid_wire_indices:
+        errors.append(
+            {
+                "code": "invalid_wire_topology",
+                "section_indices": invalid_wire_indices,
+                "message": "one or more Wire sections are topologically invalid",
+            }
+        )
+    if kind == "solid" and open_wire_indices:
+        errors.append(
+            {
+                "code": "open_solid_section",
+                "section_indices": open_wire_indices,
+                "message": "solid loft requires every Wire section to be closed",
+            }
+        )
+
+    reference_points = np.asarray(
+        [_section_reference_point(section) for section in section_list], dtype=float
+    )
+    segment_lengths = np.linalg.norm(np.diff(reference_points, axis=0), axis=1)
+    scale = max(float(np.ptp(reference_points, axis=0).max()), 1.0)
+    duplicate_spans = [
+        index
+        for index, length in enumerate(segment_lengths)
+        if float(length) <= 1e-9 * scale
+    ]
+    if duplicate_spans:
+        errors.append(
+            {
+                "code": "duplicate_section_station",
+                "span_indices": duplicate_spans,
+                "message": "adjacent section reference points occupy the same station",
+            }
+        )
+    if len(reference_points) >= 3:
+        centered = reference_points - np.mean(reference_points, axis=0)
+        _, _, right = np.linalg.svd(centered, full_matrices=False)
+        axis = right[0]
+        parameters = centered @ axis
+        if parameters[-1] < parameters[0]:
+            parameters = -parameters
+        changes = np.diff(parameters)
+        tolerance = max(1e-9 * scale, 1e-12)
+        reversals = [
+            index for index, change in enumerate(changes) if float(change) < -tolerance
+        ]
+        if reversals:
+            warnings.append(
+                {
+                    "code": "non_monotonic_section_order",
+                    "span_indices": reversals,
+                    "message": "section centers reverse along their principal station axis",
+                }
+            )
+    else:
+        parameters = np.arange(len(section_list), dtype=float)
+
+    normals: List[Tuple[int, np.ndarray]] = []
+    for index, section in enumerate(section_list):
+        if not isinstance(section, Wire) or not section.is_closed():
+            continue
+        try:
+            normal = Face(make_face_from_wire_ocp(section.wrapped)).get_normal_at()
+            normals.append(
+                (index, np.asarray([normal.x, normal.y, normal.z], dtype=float))
+            )
+        except (RuntimeError, ValueError):
+            warnings.append(
+                {
+                    "code": "section_plane_unknown",
+                    "section_index": index,
+                    "message": "closed section could not be converted to a planar face",
+                }
+            )
+    flipped_pairs = [
+        [first[0], second[0]]
+        for first, second in zip(normals, normals[1:])
+        if float(np.dot(first[1], second[1])) < 0.0
+    ]
+    if flipped_pairs:
+        warnings.append(
+            {
+                "code": "inconsistent_section_orientation",
+                "section_pairs": flipped_pairs,
+                "message": "adjacent planar section normals point in opposite directions",
+            }
+        )
+
+    requested_conditions = dict(boundary_conditions or {})
+    unsupported_conditions = [
+        name
+        for name, value in requested_conditions.items()
+        if value not in (None, {}, "free")
+    ]
+    if unsupported_conditions:
+        errors.append(
+            {
+                "code": "boundary_condition_unsupported",
+                "endpoints": unsupported_conditions,
+                "message": "the current portable loft backend cannot enforce endpoint tangent, draft, or magnitude conditions",
+            }
+        )
+
+    terminal_mode = "none"
+    if isinstance(section_list[0], Vertex) and isinstance(section_list[-1], Vertex):
+        terminal_mode = "both_points"
+    elif isinstance(section_list[0], Vertex):
+        terminal_mode = "start_point"
+    elif isinstance(section_list[-1], Vertex):
+        terminal_mode = "end_point"
+    edge_counts = [len(section._iter_edges()) for section in wire_sections]
+    section_extents = []
+    for section in section_list:
+        if isinstance(section, Vertex):
+            section_extents.append(0.0)
+            continue
+        bounds = bounding_box(section.wrapped)
+        section_extents.append(
+            float(
+                np.linalg.norm(
+                    [bounds.xlen, bounds.ylen, bounds.zlen]
+                )
+            )
+        )
+    interior_extent_extrema = [
+        index
+        for index in range(1, len(section_extents) - 1)
+        if (
+            section_extents[index]
+            > max(section_extents[index - 1], section_extents[index + 1]) * 1.05
+            or section_extents[index]
+            < min(section_extents[index - 1], section_extents[index + 1]) * 0.95
+        )
+    ]
+    if not ruled and interior_extent_extrema:
+        warnings.append(
+            {
+                "code": "smooth_overshoot_risk",
+                "section_indices": interior_extent_extrema,
+                "message": "interior section-size extrema can cause smooth loft overshoot; require STEP roundtrip and bounding-box comparison",
+            }
+        )
+    estimated_side_faces = (
+        max(edge_counts, default=0) * max(len(section_list) - 1, 1)
+        if ruled
+        else max(edge_counts, default=0)
+    )
+    valid = not errors
+    can_build_shell = valid
+    can_build_solid = valid and not open_wire_indices and kind == "solid"
+    return {
+        "schema_version": "1.0",
+        "valid": valid,
+        "can_build_shell": can_build_shell,
+        "can_build_solid": can_build_solid,
+        "result_kind": kind,
+        "ruled": bool(ruled),
+        "terminal_mode": terminal_mode,
+        "errors": errors,
+        "warnings": warnings,
+        "metrics": {
+            "section_count": len(section_list),
+            "wire_section_count": len(wire_sections),
+            "point_section_count": len(section_list) - len(wire_sections),
+            "open_wire_indices": open_wire_indices,
+            "section_parameters": [float(value) for value in parameters],
+            "adjacent_station_distances": [
+                float(value) for value in segment_lengths
+            ],
+            "estimated_side_face_count": estimated_side_faces,
+            "section_extents": section_extents,
+        },
+    }
