+    parametrization: Optional[str],
+    max_degree: Optional[int],
+) -> Dict[str, object]:
+    tolerance_value = float(tolerance)
+    if not np.isfinite(tolerance_value) or tolerance_value <= 0.0:
+        raise ValueError("loft tolerance must be a positive finite value")
+    if not isinstance(compatibility_check, bool):
+        raise TypeError("compatibility_check must be bool")
+    if smoothing is not None and not isinstance(smoothing, bool):
+        raise TypeError("smoothing must be bool or None")
+    continuity_value = None if continuity is None else str(continuity).upper()
+    if continuity_value not in {None, "C0", "C1", "C2", "C3", "G1", "G2"}:
+        raise ValueError("continuity must be C0, C1, C2, C3, G1, G2, or None")
+    parametrization_value = (
+        None if parametrization is None else str(parametrization).strip().lower()
+    )
+    if parametrization_value not in {
+        None,
+        "chord_length",
+        "centripetal",
+        "iso_parametric",
+    }:
+        raise ValueError(
+            "parametrization must be chord_length, centripetal, iso_parametric, or None"
+        )
+    degree_value = None if max_degree is None else int(max_degree)
+    if degree_value is not None and not 2 <= degree_value <= 25:
+        raise ValueError("max_degree must be between 2 and 25")
+    return {
+        "tolerance": tolerance_value,
+        "compatibility_check": compatibility_check,
+        "smoothing": smoothing,
+        "continuity": continuity_value,
+        "parametrization": parametrization_value,
+        "max_degree": degree_value,
+    }
+
+
+def _recorded_loft_build_options(
+    options: Mapping[str, object],
+) -> Dict[str, object]:
+    """Keep legacy graph params unchanged when all loft controls use defaults."""
+
+    defaults: Dict[str, object] = {
+        "tolerance": 1e-6,
+        "compatibility_check": True,
+        "smoothing": None,
+        "continuity": None,
+        "parametrization": None,
+        "max_degree": None,
+    }
+    return {
+        name: value
+        for name, value in options.items()
+        if value != defaults[name]
+    }
+
