+def _section_reference_point(section: Union[Wire, Vertex]) -> np.ndarray:
+    if isinstance(section, Vertex):
+        return np.asarray(section.get_coordinates(), dtype=float)
+    bounds = bounding_box(section.wrapped)
+    return np.asarray(
+        [
+            0.5 * (bounds.xmin + bounds.xmax),
+            0.5 * (bounds.ymin + bounds.ymax),
+            0.5 * (bounds.zmin + bounds.zmax),
+        ],
+        dtype=float,
+    )
+
