+        raise ValueError("Multi-section sweep failed: OCC solid conversion did not complete")
+    result_solid = Solid(sweep_op.Shape())
+
+    preserved: List[TopoRef] = []
+    modified: List[TopoRef] = []
+    generated: List[TopoRef] = []
+    deleted: List[TopoRef] = []
